{
  "name": "elastron",
  "version": "2.0.0",
  "description": "Full featured elasticsearch client",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "electron .",
    "dist-mac": "electron-builder -m",
    "dist-win": "electron-builder -w",
    "dist-linux": "electron-builder -l",
    "dist": "electron-builder -mwl",
    "release-mac": "electron-builder -m --publish=onTagOrDraft",
    "release-win": "electron-builder -w --publish=onTagOrDraft",
    "release-linux": "electron-builder -l --publish=onTagOrDraft",
    "release": "electron-builder -mwl --publish=onTagOrDraft",
    "upgrade-all": "yarn upgrade-interactive --latest"
  },
  "repository": "https://github.com/antonkorotkov/elastron",
  "keywords": [
    "Electron",
    "elasticsearch",
    "gui"
  ],
  "author": "Anton Korotkov",
  "license": "MIT",
  "build": {
    "files": [
      "build",
      "node_modules",
      "main.js",
      "updater.js",
      "package.json"
    ],
    "appId": "com.elastron.www",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "db.development.tools",
      "icon": "static/icon.icns",
      "gatekeeperAssess": false,
      "mergeASARs": false,
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "publish": {
        "provider": "github",
        "repo": "elastron",
        "owner": "antonkorotkov"
      }
    },
    "win": {
      "icon": "static/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "publish": {
        "provider": "github",
        "repo": "elastron",
        "owner": "antonkorotkov"
      }
    },
    "linux": {
      "icon": "static/icon.png",
      "category": "Utility",
      "publish": {
        "provider": "github",
        "repo": "elastron",
        "owner": "antonkorotkov"
      }
    }
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.12.0",
    "@electron/remote": "^2.1.2",
    "call-bind-apply-helpers": "^1.0.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "get-port": "^7.1.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@storeon/router": "~2.0.1",
    "@storeon/svelte": "^1.0.0",
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.16",
    "compare-versions": "~6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.26.0",
    "eslint-plugin-svelte": "^3.5.1",
    "globals": "^17.3.0",
    "jsdom": "^29.0.1",
    "jsoneditor": "~10.4.2",
    "percent-to-hex": "~1.0.1",
    "sass": "^1.87.0",
    "storeon": "~3.1.5",
    "svelte": "^5.49.2",
    "svelte-preprocess": "^6.0.3",
    "svelte-select": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true
  }
}