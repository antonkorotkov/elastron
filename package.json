{
  "name": "elastron",
  "version": "1.7.0",
  "description": "Full featured elasticsearch client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "start-local": "vite preview",
    "start": "ENV=development electron .",
    "start:prod": "electron .",
    "dist-mac": "electron-builder -m",
    "dist-win": "electron-builder -w",
    "dist-linux": "electron-builder -l",
    "dist": "electron-builder -mwl",
    "release-mac": "electron-builder -m --publish=onTagOrDraft",
    "release-win": "electron-builder -w --publish=onTagOrDraft",
    "release-linux": "electron-builder -l --publish=onTagOrDraft",
    "release": "electron-builder -mwl --publish=onTagOrDraft",
    "upgrade-all": "yarn upgrade-interactive --latest"
  },
  "repository": "https://github.com/antonkorotkov/elastron",
  "keywords": [
    "Electron",
    "elasticsearch",
    "gui"
  ],
  "author": "Anton Korotkov",
  "license": "MIT",
  "build": {
    "files": [
      "app",
      "node_modules",
      "dist",
      "dist-electron",
      "main.js"
    ],
    "appId": "com.elastron.www",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "db.development.tools",
      "icon": "public/icon.icns",
      "gatekeeperAssess": false,
      "mergeASARs": false,
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "publish": {
        "provider": "github",
        "repo": "elastron",
        "owner": "antonkorotkov"
      }
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "publish": {
        "provider": "github",
        "repo": "elastron",
        "owner": "antonkorotkov"
      }
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Utility",
      "publish": {
        "provider": "github",
        "repo": "elastron",
        "owner": "antonkorotkov"
      }
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "axios": "^1.9.0",
    "call-bind-apply-helpers": "^1.0.2",
    "elasticdump": "^6.119.1",
    "electron-updater": "^6.6.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@storeon/router": "~2.0.1",
    "@storeon/svelte": "~1.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/lodash": "^4.17.16",
    "compare-versions": "~6.1.1",
    "electron": "^36.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.26.0",
    "eslint-plugin-svelte": "^3.5.1",
    "globals": "^16.0.0",
    "jsoneditor": "~10.2.0",
    "local-storage": "~2.0.0",
    "percent-to-hex": "~1.0.1",
    "sass": "^1.87.0",
    "storeon": "~3.1.5",
    "svelte": "^5.28.2",
    "svelte-preprocess": "^6.0.3",
    "svelte-select": "~4.4.7",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true
  }
}